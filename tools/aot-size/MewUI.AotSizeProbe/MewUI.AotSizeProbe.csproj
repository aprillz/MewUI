<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <StripSymbols>true</StripSymbols>
    <IlcGeneratePdb>false</IlcGeneratePdb>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotSizeProbe)' == 'Text'">
    <DefineConstants>$(DefineConstants);MEWUI_AOT_SIZE_TEXT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AotSizeProbe)' == 'Button'">
    <DefineConstants>$(DefineConstants);MEWUI_AOT_SIZE_BUTTON</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AotSizeProbe)' == 'Image'">
    <DefineConstants>$(DefineConstants);MEWUI_AOT_SIZE_IMAGE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);$(AotSizePlatformDefine);$(AotSizeBackendDefine)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MewUI\MewUI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ProjectReference Include="..\..\..\src\MewUI.Platform.Win32\MewUI.Platform.Win32.csproj" />
    <ProjectReference Include="..\..\..\src\MewUI.Backend.Gdi\MewUI.Backend.Gdi.csproj"
                      Condition="'$(MewUIBackend)' == '' Or '$(MewUIBackend)' == 'Gdi'" />
    <ProjectReference Include="..\..\..\src\MewUI.Backend.Direct2D\MewUI.Backend.Direct2D.csproj"
                      Condition="'$(MewUIBackend)' == 'Direct2D'" />
    <ProjectReference Include="..\..\..\src\MewUI.Backend.MewVG.Win32\MewUI.Backend.MewVG.Win32.csproj"
                      Condition="'$(MewUIBackend)' == 'MewVG'" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <ProjectReference Include="..\..\..\src\MewUI.Platform.X11\MewUI.Platform.X11.csproj" />
    <ProjectReference Include="..\..\..\src\MewUI.Backend.MewVG.X11\MewUI.Backend.MewVG.X11.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <ProjectReference Include="..\..\..\src\MewUI.Platform.MacOS\MewUI.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\..\src\MewUI.Backend.MewVG.MacOS\MewUI.Backend.MewVG.MacOS.csproj" />
  </ItemGroup>
</Project>
