<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\MewUI.Common.props" />

  <PropertyGroup>
    <RootNamespace>Aprillz.MewUI.MewDock</RootNamespace>
    <AssemblyName>Aprillz.MewUI.MewDock</AssemblyName>
    <PackageId>Aprillz.MewUI.MewDock</PackageId>

    <!-- Same-name setters and On* subscriptions of DockingManager come from the generator. -->
    <MewUIGenerateFluentExtensions>true</MewUIGenerateFluentExtensions>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Aprillz.MewUI.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MewUI\MewUI.csproj" />
    <ProjectReference Include="..\..\src\MewUI.Generators\MewUI.Generators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" OutputItemType="Analyzer" />
    <InternalsVisibleTo Include="Aprillz.MewUI.MewDock.Test" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\MewUI\Markup\Hints\FluentHintAttributes.cs" Link="Markup\FluentHintAttributes.cs" />
  </ItemGroup>

</Project>
