<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\MewUI.Common.props" />

  <PropertyGroup>
    <RootNamespace>Aprillz.MewUI.MewvalonEdit</RootNamespace>
    <AssemblyName>Aprillz.MewUI.MewvalonEdit</AssemblyName>
    <PackageId>Aprillz.MewUI.MewvalonEdit</PackageId>
    <Description>AvalonEdit-compatible editing components built on the MewUI text engine.</Description>

    <!-- Same-name setters and On* subscriptions of the editor controls come from the generator. -->
    <MewUIGenerateFluentExtensions>true</MewUIGenerateFluentExtensions>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Aprillz.MewUI.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <!-- The original's own syntax definitions and their schemas, read by HighlightingLoader. -->
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\Resources\*.xshd" />
    <EmbeddedResource Include="Highlighting\Resources\*.xsd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MewUI\MewUI.csproj" />
    <ProjectReference Include="..\..\src\MewUI.Generators\MewUI.Generators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" OutputItemType="Analyzer" />
    <None Include="LICENSE.AvalonEdit" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>
