<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\MewUI.Common.props" />
  <PropertyGroup>
    <AssemblyName>$(MewUITitle).Markdown</AssemblyName>
    <PackageId>$(MewUITitle).Markdown</PackageId>
    <Description>Native Markdown controls for MewUI using Markdig.</Description>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MewUI\MewUI.csproj" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <InternalsVisibleTo Include="Aprillz.MewUI.Markdown.Test" />
  </ItemGroup>
</Project>
