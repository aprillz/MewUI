<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/MewUI.Common.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <DefineConstants>$(DefineConstants);MEWUI_BROWSER_FIRST_BOOT</DefineConstants>
    <AssemblyName>$(MewUITitle).Backend.MewVG.Browser</AssemblyName>
    <PackageId>$(MewUITitle).Backend.MewVG.Browser</PackageId>
    <Description>MewVG WebGL2 backend for $(MewUITitle) Browser First Boot</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(MewVGProjectPath)' == ''">
    <PackageReference Include="Aprillz.MewVG.Core" Version="$(MewVGVersion)" />
    <PackageReference Include="Aprillz.MewVG.GL" Version="$(MewVGVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MewVGProjectPath)' != ''">
    <ProjectReference Include="$(MewVGProjectPath)/src/MewVG.Core/MewVG.Core.csproj" />
    <ProjectReference Include="$(MewVGProjectPath)/src/MewVG.GL/MewVG.GL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MewUI/MewUI.csproj" AdditionalProperties="MewUITargetFrameworks=net10.0" />
    <ProjectReference Include="../MewUI.Platform.Browser/MewUI.Platform.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../MewUI/Shared/Rendering/Common/TextBitmap.cs" LinkBase="Rendering/Common" />
    <Compile Include="../MewUI/Shared/Rendering/Common/TextCacheKey.cs" LinkBase="Rendering/Common" />

    <Compile Include="../MewUI/Shared/Rendering/MewVG/MewVGGraphicsContext.Common.cs" LinkBase="Rendering/MewVG" />
    <Compile Include="../MewUI/Shared/Rendering/MewVG/MewVGGraphicsFactory.cs" LinkBase="Rendering/MewVG" />
    <Compile Include="../MewUI/Shared/Rendering/MewVG/MewVGImage.cs" LinkBase="Rendering/MewVG" />
    <Compile Include="../MewUI/Shared/Rendering/MewVG/MewVGExternalRasterImage.cs" LinkBase="Rendering/MewVG" />
    <Compile Include="../MewUI/Shared/Rendering/MewVG/MewVGTextCache.cs" LinkBase="Rendering/MewVG" />
    <Compile Include="../MewUI/Shared/Rendering/MewVG/MewVGGLOffscreenSurfaceProvider.cs" LinkBase="Rendering/MewVG" />
    <Compile Include="../MewUI/Shared/Rendering/MewVG/NvgStrokeHelper.cs" LinkBase="Rendering/MewVG" />

    <Compile Include="../MewUI/Shared/Rendering/OpenGL/IGLTextureSource.cs" LinkBase="Rendering/OpenGL" />
    <Compile Include="../MewUI/Shared/Rendering/OpenGL/IOpenGLWindowResources.cs" LinkBase="Rendering/OpenGL" />
    <Compile Include="../MewUI/Shared/Rendering/OpenGL/OpenGLPixelRenderSurface.cs" LinkBase="Rendering/OpenGL" />
    <Compile Include="../MewUI/Shared/Rendering/OpenGL/BrowserOpenGLWindowResources.cs" LinkBase="Rendering/OpenGL" />

    <Compile Include="../MewUI/Shared/Native/GL.Common.cs" LinkBase="Native" />
    <Compile Include="../MewUI/Shared/Native/OpenGLExt.cs" LinkBase="Native" />
    <Compile Include="../MewUI/Shared/Native/Browser/*.cs" LinkBase="Native/Browser" />
    <Compile Include="../MewUI/Shared/Native/Common/Structs/*.cs" LinkBase="Native/Structs" />
  </ItemGroup>

  <ItemGroup>
    <NativeFileReference Include="mewui_webgl_shim.c" />
  </ItemGroup>

</Project>
