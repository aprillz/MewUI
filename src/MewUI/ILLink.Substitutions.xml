<linker>
  <!--
    Conditional substitution: it applies only when the app sets the feature switch to false, so
    <MewUIDevTools>true</MewUIDevTools> leaves the gate readable and keeps the DevTools graph.
  -->
  <assembly fullname="Aprillz.MewUI">
    <type fullname="Aprillz.MewUI.Diagnostics.DevToolsGate">
      <method signature="System.Boolean get_IsSupported()" body="stub" value="false"
              feature="Aprillz.MewUI.DevTools.Enabled" featurevalue="false" />
    </type>
    <type fullname="Aprillz.MewUI.ManagedFileDialogGate">
      <method signature="System.Boolean get_IsSupported()" body="stub" value="false"
              feature="Aprillz.MewUI.ManagedFileDialogs.Enabled" featurevalue="false" />
    </type>
    <type fullname="Aprillz.MewUI.Diagnostics.EnvironmentDebugLoggingGate">
      <method signature="System.Boolean get_IsSupported()" body="stub" value="false"
              feature="Aprillz.MewUI.EnvironmentDebugLogging.Enabled" featurevalue="false" />
    </type>
  </assembly>
</linker>
