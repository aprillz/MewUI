<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <AssemblyName>Aprillz.MewUI.MewDock.Test</AssemblyName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extensions\MewUI.MewDock\MewUI.MewDock.csproj" />
    <!-- GDI backend (Windows-only at runtime) so layout tests can measure text. -->
    <ProjectReference Include="..\..\src\MewUI.Backend.Gdi\MewUI.Backend.Gdi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A drawing sink for rendering a control outside a window. -->
    <Compile Include="..\MewUI.Test\Infrastructure\NoOpGraphicsContext.cs" Link="Infrastructure\NoOpGraphicsContext.cs" />
    <!-- A window backend that lays out and tracks focus without a native window. -->
    <Compile Include="..\MewUI.Test\Infrastructure\HeadlessWindowBackend.cs" Link="Infrastructure\HeadlessWindowBackend.cs" />
  </ItemGroup>

  <!-- The markup audit library targets net10.0 only; the fluent audit tests are compiled there. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\tools\MewUI.MarkupAudit\MewUI.MarkupAudit.Core\MewUI.MarkupAudit.Core.csproj" />
    <Compile Include="..\MewUI.Test\Infrastructure\FluentAuditScope.cs" Link="Infrastructure\FluentAuditScope.cs" />
  </ItemGroup>

</Project>
