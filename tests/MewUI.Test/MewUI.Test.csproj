<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <AssemblyName>Aprillz.MewUI.Test</AssemblyName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MewUI\MewUI.csproj" />
    <!-- GDI backend (Windows-only at runtime) for offscreen render-surface validation tests. -->
    <ProjectReference Include="..\..\src\MewUI.Backend.Gdi\MewUI.Backend.Gdi.csproj"
                      Aliases="global,gdibackend" />
    <!-- Backend/platform audit coverage only; product reference graph remains unchanged. -->
    <!-- The DirectWrite sources are linked into every Win32 backend, so a test that names one of
         those types sees it in two referenced assemblies. The extra alias lets such a test say which
         copy it means; everything else keeps reaching the backend through the global namespace. -->
    <ProjectReference Include="..\..\src\MewUI.Backend.Direct2D\MewUI.Backend.Direct2D.csproj"
                      Aliases="global,direct2d" />
    <ProjectReference Include="..\..\src\MewUI.Backend.MewVG.Win32\MewUI.Backend.MewVG.Win32.csproj"
                      Aliases="MewVGWin32" />
    <ProjectReference Include="..\..\src\MewUI.Backend.MewVG.X11\MewUI.Backend.MewVG.X11.csproj"
                      Aliases="MewVGX11" />
    <ProjectReference Include="..\..\src\MewUI.Backend.MewVG.MacOS\MewUI.Backend.MewVG.MacOS.csproj"
                      Aliases="MewVGMacOS" />
    <ProjectReference Include="..\..\src\MewUI.Platform.X11\MewUI.Platform.X11.csproj" />
    <ProjectReference Include="..\..\src\MewUI.Platform.Win32\MewUI.Platform.Win32.csproj" />
    <ProjectReference Include="..\..\src\MewUI.Preview\MewUI.Preview.csproj" />
  </ItemGroup>

</Project>
