<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <AssemblyName>Aprillz.MewUI.Terminal.Test</AssemblyName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extensions\MewUI.Terminal\MewUI.Terminal.csproj" />
  </ItemGroup>

  <!-- The markup audit library targets net10.0 only; the fluent audit tests are compiled there. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\tools\MewUI.MarkupAudit\MewUI.MarkupAudit.Core\MewUI.MarkupAudit.Core.csproj" />
    <Compile Include="..\MewUI.Test\Infrastructure\FluentAuditScope.cs" Link="Infrastructure\FluentAuditScope.cs" />
  </ItemGroup>

</Project>
